# Copia este archivo como .env (local) o carga estas variables en Render > Environment.
# Los valores de aquí son FICTICIOS. Nunca subas el .env real al repositorio.

# --- Obligatorias ---
# Cadena de conexión de Supabase (Project Settings > Database). Recomendado: pooler de transacciones, puerto 6543.
DATABASE_URL=postgresql://usuario:contrasena@host-ficticio.pooler.supabase.com:6543/postgres
# Firma de los tokens de sesión (JWT). Genera una con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=cambia-esto-por-una-clave-aleatoria-larga
# Clave de Django (sesiones/admin). Genera otra distinta con el mismo comando.
SECRET_KEY=cambia-esto-por-otra-clave-aleatoria-larga

# --- Producción (Render) ---
# Orígenes exactos del frontend, https y sin barra final, separados por comas.
CORS_ALLOWED_ORIGINS=https://tu-frontend.vercel.app
# Opcional: hosts del backend separados por comas (Render agrega solo su dominio con RENDER_EXTERNAL_HOSTNAME).
ALLOWED_HOSTS=tu-backend.onrender.com
# Opcional: por defecto se copian los orígenes https de CORS_ALLOWED_ORIGINS.
CSRF_TRUSTED_ORIGINS=https://tu-frontend.vercel.app

# --- Usuario demo (python manage.py seed_demo) ---
DEMO_EMAIL=demo@organiza-eventos.app
DEMO_PASSWORD=una-contrasena-demo-fuerte

# --- Solo desarrollo local ---
# DEBUG=True muestra páginas de depuración. Nunca en producción.
# DEBUG=True
